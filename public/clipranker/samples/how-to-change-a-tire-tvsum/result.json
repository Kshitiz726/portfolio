63,"text":0.3838,"speech_continues":false,"score":0.698,"chosen":true},{"time":224.976,"visual":0.02,"text":0.4973,"speech_continues":true,"score":-1.776,"chosen":false},{"time":229.976,"visual":0.0369,"text":0.5714,"speech_continues":true,"score":-1.213,"chosen":false},{"time":235.476,"visual":0.0881,"text":0.463,"speech_continues":true,"score":-0.339,"chosen":false},{"time":242.476,"visual":0.0253,"text":0.5471,"speech_continues":true,"score":-1.533,"chosen":false},{"time":246.746,"visual":0.0804,"text":0.4254,"speech_continues":true,"score":-0.606,"chosen":false},{"time":265.866,"visual":0.0229,"text":0.7981,"speech_continues":false,"score":0.54,"chosen":false},{"time":268.866,"visual":0.0152,"text":0.5879,"speech_continues":true,"score":-1.656,"chosen":false},{"time":271.866,"visual":0.0328,"text":0.692,"speech_continues":true,"score":-1.003,"chosen":false},{"time":276.866,"visual":0.0234,"text":0.3711,"speech_continues":true,"score":-2.015,"chosen":false},{"time":282.866,"visual":0.0269,"text":0.3361,"speech_continues":true,"score":-2.025,"chosen":false},{"time":287.287,"visual":0.0199,"text":0.3505,"speech_continues":true,"score":-2.144,"chosen":false},{"time":299.366,"visual":0.0709,"text":0.6659,"speech_continues":true,"score":-0.217,"chosen":false},{"time":302.369,"visual":0.0991,"text":0.5498,"speech_continues":true,"score":0.123,"chosen":false},{"time":311.344,"visual":0.3399,"text":0.8534,"speech_continues":false,"score":7.764,"chosen":true},{"time":314.844,"visual":0.2283,"text":0.6403,"speech_continues":true,"score":3.236,"chosen":false},{"time":322.344,"visual":0.014,"text":0.2607,"speech_continues":true,"score":-2.503,"chosen":false},{"time":327.844,"visual":0.0076,"text":0.5555,"speech_continues":false,"score":-0.407,"chosen":false},{"time":331.344,"visual":0.0077,"text":0.7249,"speech_continues":true,"score":-1.482,"chosen":false},{"time":335.344,"visual":0.0075,"text":0.3839,"speech_continues":true,"score":-2.339,"chosen":false},{"time":338.344,"visual":0.0044,"text":0.5614,"speech_continues":true,"score":-1.965,"chosen":false},{"time":347.344,"visual":0.0045,"text":0.2849,"speech_continues":true,"score":-2.654,"chosen":false},{"time":350.344,"visual":0.0039,"text":0.1969,"speech_continues":true,"score":-2.887,"chosen":false}],"transcript":[{"start":0.0,"end":11.6,"text":"If you didn't know already how to do it, here's how to change trailer, ATV, lawn tractor,"},{"start":11.6,"end":16.52,"text":"motorcycle, you know, and small vehicle tires just with a couple screwdriver or something"},{"start":16.52,"end":17.52,"text":"like that."},{"start":17.52,"end":20.36,"text":"They all work pretty much the same way."},{"start":20.36,"end":23.44,"text":"First of all, there's three kinds of bead styles."},{"start":23.44,"end":26.72,"text":"The first bead style is the tube style tire."},{"start":26.72,"end":32.44,"text":"It doesn't have very much of a bump or anything on the inside of the rim to lock the rubber"},{"start":32.44,"end":35.04,"text":"bead of the tire to the outside of the rim."},{"start":35.04,"end":39.58,"text":"It just can be slipped right off by just stepping on the edge of the tire and it will separate"},{"start":39.58,"end":41.72,"text":"the tire from the edge of the rim."},{"start":41.72,"end":47.84,"text":"Tubeless tire design like car tires and many other things have a partially locking sealing"},{"start":47.84,"end":52.2,"text":"system to bead to rim and they're more difficult to separate."},{"start":52.2,"end":59.94,"text":"may need to squish the tire in a vise, press it in a tire machine, or place the"},{"start":59.94,"end":62.98,"text":"tire you're going to change right in front of the wheel of a vehicle and"},{"start":62.98,"end":67.94,"text":"slowly drive over the rubber part close to the rim and that may break it for you."},{"start":67.94,"end":72.54,"text":"It's usually stupid to try to beat it with a big hammer, you'll usually end up"},{"start":72.54,"end":78.54,"text":"wrecking your rim. Another method is put the rubber part of the tire on your"},{"start":78.54,"end":83.58,"text":"face of your jack and put it underneath a high vehicle or something heavy and start"},{"start":83.58,"end":88.26,"text":"jacking it up and that will create a lot of pressure and a squishing edge to"},{"start":88.26,"end":95.86,"text":"break the bead. So once that's done, the way you change the tire is I like to set"},{"start":95.86,"end":100.9,"text":"the nipple for the air fill at least to that side or that side and start there."},{"start":100.9,"end":108.02,"text":"So you step on your tire and you get the bead to drop to the lowest pocket"},{"start":108.02,"end":114.8,"text":"inside your rim. Then you get a pair of screwdriver and if you have no tube in"},{"start":114.8,"end":117.92,"text":"there you don't have to worry but if you have a tube you have to be very careful"},{"start":117.92,"end":123.48,"text":"not to prick your tube. It's sometimes very important not to have that nipple"},{"start":123.48,"end":127.4,"text":"either on the business area here or where you're working where you're starting."},{"start":127.4,"end":131.96,"text":"It gets in the way and it sometimes causes you not to be able to get your"},{"start":131.96,"end":137.16,"text":"bead to drop deeply into the pocket or if you have a tube it causes your tube to"},{"start":137.16,"end":140.2,"text":"stick up there somewhat and your screwdriver will catch it and damage it."},{"start":140.2,"end":145.2,"text":"So now I've got it stepped on and I've got my screwdriver carefully in there in"},{"start":145.2,"end":149.8,"text":"case there's a tube and I've got a lip pried up and I just get some soapy water"},{"start":149.8,"end":154.56,"text":"or something or spray-nine or something like that and I lube the edges like so."},{"start":154.56,"end":160.24,"text":"Now by taking small bites of the tire at a time I start to unpeel it while"},{"start":160.24,"end":164.2,"text":"still keeping the pressure on the other side to keep the bead into the deep groove."},{"start":164.2,"end":171.2,"text":"It may be also necessary sometimes to, say for example, pinch your rim a little bit with a visegrip right there"},{"start":171.2,"end":178.2,"text":"to stop the tire from slipping around at the same time you're unpeeling it off or peeling it back on."},{"start":178.2,"end":187.2,"text":"Well, if that took about one minute, it's all peeled. If you have a tube type tire, you only have to peel one side off."},{"start":187.2,"end":194.2,"text":"You can just lift your tire up and get enough space there to get your hand in there and get out the tube."},{"start":194.2,"end":200.2,"text":"If you want to completely take the tire off the rim, it's best to just flip it over like I did now"},{"start":200.2,"end":206.2,"text":"and work from the back side to stick your shoe divers here and there and pry the tire off that way."},{"start":206.2,"end":209.2,"text":"The second side always comes off a lot easier."},{"start":209.2,"end":212.2,"text":"My tire had a tube in it, that's the way I want it to be,"},{"start":212.2,"end":216.2,"text":"but when you're installing new tubes or even putting the old one back in,"},{"start":216.2,"end":222.2,"text":"Tubes very often have a right or left side unless they're on a motorcycle."},{"start":222.2,"end":225.44,"text":"So that means the nipple is more off-center."},{"start":225.44,"end":228.04,"text":"If you put it in backwards, it may go in fine."},{"start":228.04,"end":232.98,"text":"As soon as you start blowing it up, all of a sudden it'll suck itself in."},{"start":232.98,"end":234.76,"text":"You can't get a hole in the nipple anymore."},{"start":234.76,"end":238.12,"text":"You've got your tire all put back together."},{"start":238.12,"end":242.04,"text":"The only way to get your tire back apart is actually put a hole in it and bleed the air"},{"start":242.04,"end":243.36,"text":"out and start all over again."},{"start":243.36,"end":245.58,"text":"Then patch your hole if you put the tube in upside down."},{"start":245.58,"end":251.04,"text":"that sucks. To put it back on, I've got the valve stem over there, a vise grip"},{"start":251.04,"end":254.88,"text":"opposite to it. Now I'm going to stand as best as I can here. Sometimes it takes"},{"start":254.88,"end":260.1,"text":"two people. Get that lip into the deep groove and then get my screwdriver and"},{"start":260.1,"end":265.68,"text":"work this all the way around and slowly peel it on by small amounts at a time."},{"start":265.68,"end":273.44,"text":"And that just went on in 30 seconds. Of course sometimes it takes longer. Now"},{"start":273.44,"end":279.32,"text":"Now especially on quad tires, reseal the bead takes a lot of pressure because it's that"},{"start":279.32,"end":284.56,"text":"high pressure locking bead because it's a low pressure tire."},{"start":284.56,"end":291.74,"text":"So my advice is to put spray nine or soapy water all the way around both sides of the"},{"start":291.74,"end":295.8,"text":"bead and then put your lots of air pressure in."},{"start":295.8,"end":303.12,"text":"And even park it in the sun because warming it up helps it slip on too."},{"start":303.12,"end":304.12,"text":"And it's done."},{"start":304.12,"end":306.52,"text":"It's actually pretty easy."},{"start":306.52,"end":308.88,"text":"No use paying someone 25 bucks or something."},{"start":308.88,"end":311.4,"text":"It's just basic tools and a little bit of weight."},{"start":311.4,"end":316.8,"text":"Last thing, I didn't mention that I took that quad tire to a shop and had them use"},{"start":316.8,"end":318.84,"text":"their machine to break the bead."},{"start":318.84,"end":325.96,"text":"ATV tires or quad tires are very low pressure so they don't use air to give a tight fit"},{"start":325.96,"end":328.08,"text":"to lock the bead to the rim."},{"start":328.08,"end":332.32,"text":"They have a bead locking design which is very difficult to break the bead."},{"start":332.32,"end":336.76,"text":"The other methods I showed and talked about probably won't work."},{"start":336.76,"end":340.88,"text":"So if you don't have one of those kind of machines, you better go to a place and have"},{"start":340.88,"end":343.0,"text":"someone break the bead for you."},{"start":343.0,"end":346.68,"text":"They have this kind of high pressure locking bead because the tires are low pressure and"},{"start":346.68,"end":350.8,"text":"if you're doing hard cornering, you don't want the tire to all of a sudden flip off"},{"start":350.8,"end":352.52,"text":"the rim and then roll your machine."}],"language":"en","frame_importance":[0.4977000057697296,0.5218999981880188,0.5203999876976013,0.5238000154495239,0.43849998712539673,0.4368000030517578,0.42100000381469727,0.04910000041127205,0.05660000070929527,0.05739999935030937,0.06120000034570694,0.06859999895095825,0.0625,0.060100000351667404,0.06639999896287918,0.07599999755620956,0.09139999747276306,0.09070000052452087,0.09929999709129333,0.1062999963760376,0.09759999811649323,0.1256999969482422,0.12309999763965607,0.09619999676942825,0.09279999881982803,0.08730000257492065,0.09610000252723694,0.05350000038743019,0.066600002348423,0.05719999969005585,0.06340000033378601,0.05429999902844429,0.06870000064373016,0.06530000269412994,0.07900000363588333,0.07320000231266022,0.06360000371932983,0.0625,0.07199999690055847,0.08510000258684158,0.3522999882698059,0.3619999885559082,0.3319999873638153,0.3059000074863434,0.3034000098705292,0.29899999499320984,0.04540000110864639,0.039000000804662704,0.03310000151395798,0.031700000166893005,0.027699999511241913,0.024399999529123306,0.027300000190734863,0.030500000342726707,0.031599998474121094,0.03539999946951866,0.03269999846816063,0.033900000154972076,0.03400000184774399,0.03579999879002571,0.039900001138448715,0.04259999841451645,0.03929999843239784,0.04019999876618385,0.040800001472234726,0.03999999910593033,0.041099999099969864,0.038600001484155655,0.04170000180602074,0.040500000